# 复制为 .env 后填写；在项目根目录用 set -a; source .env; set +a 导入。
# LLM：填写你的 Chat Completions 网关地址、密钥和实际可用模型 ID。
LITELLM_API_BASE='https://your-llm-gateway.example/v1'
LITELLM_API_KEY=''
STEEL_FOREST_LLM_MODEL=''

# 文献：至少填写一个；不使用的留空。两项都有值时 auto 会请求两者。
BOHR_ACCESS_KEY=''
DPRAG_API_KEY=''

# 以下均可不改。LLM 专用代理不自动用于文献服务。
# LITELLM_SOCKS5_PROXY='socks5h://127.0.0.1:1080'
# STEEL_FOREST_LLM_TIMEOUT_SEC=180
# STEEL_FOREST_MAX_REQUEST_CHARS=128000
# STEEL_FOREST_LLM_ENDPOINT='/chat/completions'
# STEEL_FOREST_LLM_RESPONSE_FORMAT='none'  # 仅当网关不支持 response_format 字段
# STEEL_FOREST_LLM_ENABLE_THINKING=false  # 仅当网关支持 chat_template_kwargs

# 文献服务默认地址；由服务方告知需要更换时才取消注释并修改。
# LKM_API_BASE='https://open.bohrium.com/openapi/v2/lkm'
# DPRAG_API_BASE='https://funmg.dp.tech/sci-loop-dev-api/api/v1/literature/retrieve-context'
